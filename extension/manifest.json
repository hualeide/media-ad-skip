{
  "manifest_version": 3,
  "name": "Media Ad Skip",
  "version": "1.5.72",
  "description": "像绯红之王一样删除广告时间。B站 / 抖音网页版片内与信息流跳过。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Media Ad Skip · 删除广告时间",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "media-ad-skip@hualeide.github.io",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.douyin.com/*",
    "*://*.iesdouyin.com/*",
    "*://bsbsb.top/*",
    "*://api.bilibili.com/*",
    "*://comment.bilibili.com/*",
    "*://i0.hdslb.com/*",
    "*://i1.hdslb.com/*",
    "*://i2.hdslb.com/*",
    "*://s1.hdslb.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/watchlater/*",
        "*://www.bilibili.com/bangumi/*",
        "*://m.bilibili.com/video/*",
        "*://www.douyin.com/*",
        "*://www.iesdouyin.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-bridge.js"],
      "matches": [
        "*://www.douyin.com/*",
        "*://www.iesdouyin.com/*"
      ]
    }
  ]
}
